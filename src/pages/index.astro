---
const title = 'Ирина Трунькина — врач-кардиолог и терапевт';
const description = 'Официальный сайт Ирины Трунькиной. Кардиология в контексте общего здоровья, очный приём и запись.';
const portrait = 'data:image/jpeg;base64,';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <style>
    @import url('https://fonts.bunny.net/css?family=manrope:400,500,600,700');
    :root {font-family: Manrope, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;--bg:#fbfbfa;--card:#fff;--ink:#20272a;--muted:#687176;--line:#e7e9e8;--accent:#526f78;--soft:#f2f5f5;--soft2:#f7f8f8}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink)}main{padding:22px 18px 64px}.wrap{width:min(1060px,100%);margin:auto}.hero{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);gap:48px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:22px;padding:46px}.hero-photo{margin:0;max-width:360px;justify-self:end}.hero-photo img{display:block;width:100%;height:auto;border-radius:18px;border:1px solid var(--line)}.eyebrow,.kicker,.label{margin:0;color:var(--accent);font-size:12px;font-weight:700;letter-spacing:.045em;text-transform:uppercase}.eyebrow{display:inline-flex;background:var(--soft);border-radius:999px;padding:7px 11px;margin-bottom:18px}h1{margin:0;font-size:clamp(36px,4.5vw,48px);font-weight:650;line-height:1.04;letter-spacing:-.025em;white-space:nowrap}.tagline{margin:22px 0 0;color:var(--accent);font-size:clamp(28px,3.4vw,36px);font-weight:600;line-height:1.12;letter-spacing:-.02em}.subhead{margin:12px 0 0;font-size:20px;font-weight:600;line-height:1.45}.lead,.intro{color:var(--muted);line-height:1.68}.lead{margin:18px 0 0;max-width:650px;font-size:16px}.detail{margin:18px 0 0;max-width:620px;padding:13px 15px;background:var(--soft);border-left:2px solid var(--accent);border-radius:10px;color:#44545a;font-size:14px;line-height:1.6}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:23px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 20px;border-radius:999px;background:var(--accent);color:#fff;text-decoration:none;font-weight:700;font-size:14px}.section{padding-top:64px}.section-head{max-width:780px}.kicker{margin-bottom:9px}.section h2,.final h2{margin:0;max-width:780px;font-size:clamp(28px,3.2vw,36px);font-weight:600;line-height:1.18;letter-spacing:-.015em;text-wrap:balance}.intro{margin:14px 0 0;max-width:750px;font-size:15px}.grid2,.facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:24px}.facts{grid-template-columns:repeat(3,minmax(0,1fr))}.box{background:var(--card);border:1px solid var(--line);border-radius:15px;padding:20px}.box h3{margin:0;font-size:18px;font-weight:600;line-height:1.35;text-wrap:balance}.box p{margin:8px 0 0;color:var(--muted);font-size:14px;line-height:1.58}.note{margin:17px 0 0;color:#80878a;font-size:12px;line-height:1.55}.approach{margin-top:24px;background:var(--soft2);border:1px solid var(--line);border-radius:16px;padding:26px}.approach-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 28px}.step{display:grid;grid-template-columns:32px 1fr;gap:11px}.num{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:#fff;border:1px solid var(--line);color:var(--accent);font-size:11px;font-weight:700}.step h3{margin:1px 0 0;font-size:16px;font-weight:600;line-height:1.35}.step p{margin:6px 0 0;color:var(--muted);font-size:13px;line-height:1.58}.summary{margin:22px 0 0;padding-top:18px;border-top:1px solid var(--line);color:#46565b;font-size:16px;line-height:1.6}.data-summary{margin:12px 0 0;padding:17px 19px;background:var(--soft);border-radius:13px;color:#46565b;font-size:14px;line-height:1.6}.fact strong{display:block;margin-top:8px;font-size:18px;font-weight:600}.education{margin-top:12px;background:#fff;border:1px solid var(--line);border-radius:15px;padding:24px}.education h3{margin:0 0 16px;font-size:20px;font-weight:600}.row{display:grid;grid-template-columns:110px 1fr;gap:18px;padding:14px 0;border-top:1px solid var(--line)}.row:first-of-type{border-top:0;padding-top:0}.year{color:var(--accent);font-weight:700}.row div:last-child{color:var(--muted);line-height:1.55;font-size:14px}.clinic{display:grid;grid-template-columns:1.2fr .8fr;gap:26px;align-items:center;margin-top:22px;background:#fff;border:1px solid var(--line);border-radius:15px;padding:26px}.clinic h3{margin:8px 0 0;font-size:27px;font-weight:600;line-height:1.2}.clinic p{margin:10px 0 0;color:var(--muted);font-size:14px;line-height:1.6}.address{font-weight:600;color:#46565b!important}.clinic-action{display:flex;justify-content:flex-end}.final{margin-top:64px;padding:34px;background:var(--soft2);border:1px solid var(--line);border-radius:16px}.final p{margin:14px 0 0;max-width:740px;color:var(--muted);font-size:15px;line-height:1.62}@media(max-width:820px){.hero{grid-template-columns:1fr}.hero-photo{order:-1;max-width:520px;justify-self:stretch;margin:auto}}@media(max-width:720px){main{padding:10px 10px 44px}.hero{padding:18px;gap:22px;border-radius:18px}.hero-photo{max-width:none}.hero-photo img{border-radius:14px}h1{font-size:clamp(29px,8.4vw,34px);white-space:nowrap}.tagline{margin-top:18px;font-size:27px}.subhead{font-size:17px}.lead{font-size:15px}.detail{font-size:13.5px}.section{padding-top:48px}.section h2,.final h2{font-size:25px;line-height:1.2;text-wrap:balance}.intro{font-size:14.5px}.grid2,.facts,.approach-grid,.clinic{grid-template-columns:1fr}.grid2,.facts{gap:9px;margin-top:19px}.box{padding:17px}.box h3{font-size:17px}.approach{margin-top:19px;padding:18px}.approach-grid{gap:18px}.row{grid-template-columns:1fr;gap:4px}.clinic{gap:18px;padding:20px}.clinic h3{font-size:23px}.clinic-action{justify-content:flex-start}.final{margin-top:48px;padding:24px 20px}}
  </style>
</head>
<body><main><div class="wrap">
<section class="hero"><div class="hero-copy"><p class="eyebrow">Врач-кардиолог · терапевт</p><h1>Ирина Трунькина</h1><h2 class="tagline">Не только сердце</h2><p class="subhead">Кардиология в контексте всего организма.</p><p class="lead">Сердечно-сосудистые симптомы и риски рассматриваются с учётом обмена веществ, веса, сопутствующих состояний, образа жизни и данных обследований.</p><p class="detail"><strong>При необходимости — расширенный разбор анализов и генетических данных.</strong></p><div class="actions"><a class="button" href="https://lk.medgarant.info/reservation?initial=doc&step=datetime&department=10020850&dcode=10000436">Записаться на очный приём</a></div></div><figure class="hero-photo"><img src={portrait} alt="Ирина Трунькина, врач-кардиолог и терапевт" width="300" height="375" /></figure></section>
<section class="section" aria-labelledby="situations-title"><div class="section-head"><p class="kicker">С чем можно обратиться</p><h2 id="situations-title">Когда важно разобраться не только с одним симптомом</h2><p class="intro">Поводом для консультации может быть не только уже установленный диагноз. Иногда задача — понять, что стоит за жалобами, оценить риски и собрать разрозненные данные в понятный план.</p></div><div class="grid2"><article class="box"><h3>Давление остаётся высоким</h3><p>Если показатели часто повышаются, лечение приходится менять или самочувствие остаётся нестабильным.</p></article><article class="box"><h3>Одышка, сердцебиение, слабость</h3><p>Когда симптомы есть, а обследования не дают простого и понятного объяснения.</p></article><article class="box"><h3>Боль или дискомфорт в груди</h3><p>Чтобы оценить сердечно-сосудистый риск и понять, какое обследование действительно нужно дальше.</p></article><article class="box"><h3>Высокий холестерин или атеросклероз</h3><p>Если нужно оценить общий риск, разобраться в показателях и понять дальнейшую тактику.</p></article><article class="box"><h3>Вес, сахар, давление и холестерин связаны между собой</h3><p>Когда сердечно-сосудистый риск нельзя рассматривать отдельно от обмена веществ и сопутствующих состояний.</p></article><article class="box"><h3>Диагноз уже есть, но остаются вопросы</h3><p>Если хочется спокойно пересмотреть результаты обследований, лечение и дальнейшие шаги.</p></article></div><p class="note">Перечень не заменяет медицинскую оценку и не является списком диагнозов для самодиагностики.</p></section>
<section class="section" aria-labelledby="approach-title"><div class="section-head"><p class="kicker">Как строится разбор</p><h2 id="approach-title">Симптом — это начало разбора, а не всегда готовый диагноз</h2><p class="intro">Сердечно-сосудистые жалобы оцениваются в общей клинической картине: важно понять не только, что беспокоит сейчас, но и какие факторы могут поддерживать симптомы и влиять на риск.</p></div><div class="approach"><div class="approach-grid"><article class="step"><div class="num">01</div><div><h3>Что происходит сейчас</h3><p>Жалобы, их динамика, уже поставленные диагнозы, результаты обследований и текущее лечение.</p></div></article><article class="step"><div class="num">02</div><div><h3>Что влияет на сердечно-сосудистый риск</h3><p>Давление, липидный и углеводный обмен, вес, сопутствующие заболевания и другие значимые факторы.</p></div></article><article class="step"><div class="num">03</div><div><h3>Что может быть связано с симптомами</h3><p>При необходимости учитываются сопутствующие состояния, образ жизни, принимаемые препараты, лабораторные данные и результаты других исследований.</p></div></article><article class="step"><div class="num">04</div><div><h3>Какой следующий шаг действительно нужен</h3><p>Что уже понятно, что стоит уточнить, как выстроить дальнейшее обследование, лечение или маршрутизацию.</p></div></article></div><p class="summary">Если причина симптомов выходит за рамки кардиологии, задача — не остановиться на формулировке «с сердцем всё нормально», а понять, <strong>куда смотреть дальше и как собрать последовательный план действий.</strong></p></div></section>
<section class="section" aria-labelledby="data-title"><div class="section-head"><p class="kicker">Дополнительные данные</p><h2 id="data-title">Когда в общей картине важны анализы и генетика</h2><p class="intro">Не каждому пациенту нужен генетический тест или расширенный набор исследований. Но если такие данные уже есть или для них есть клиническая задача, их можно рассматривать вместе с анамнезом, симптомами и обычной диагностикой.</p></div><div class="grid2"><article class="box"><p class="label">Лабораторные данные</p><h3>Не отдельные цифры, а их место в общей картине</h3><p>Результаты анализов сопоставляются с жалобами, диагнозами, лечением и факторами риска, чтобы понять, какие показатели действительно требуют внимания и что стоит уточнить дальше.</p></article><article class="box"><p class="label">Генетические исследования</p><h3>Дополнительный источник информации, а не диагноз сам по себе</h3><p>Если генетическое исследование уже выполнено, его результаты рассматриваются как часть более широкой клинической картины. Генетические данные не заменяют обследование и не определяют лечение изолированно.</p></article></div><p class="data-summary"><strong>Смысл не в «лечении по генам».</strong> Дополнительные данные используются только там, где они могут помочь лучше сформулировать вопросы профилактики, обследования и дальнейшего наблюдения.</p></section>
<section class="section" aria-labelledby="about-title"><div class="section-head"><p class="kicker">О враче</p><h2 id="about-title">Кардиолог, терапевт, врач функциональной диагностики</h2><p class="intro">Ирина Трунькина работает со взрослыми пациентами с заболеваниями сердечно-сосудистой системы и терапевтической патологией. Стаж работы — с 2006 года.</p></div><div class="facts"><article class="box fact"><p class="label">Базовое образование</p><strong>Лечебное дело</strong><p>Тверская государственная медицинская академия, 2005 год.</p></article><article class="box fact"><p class="label">Специализация</p><strong>Кардиология</strong><p>Профессиональная переподготовка, 2007 год.</p></article><article class="box fact"><p class="label">Квалификация</p><strong>Первая категория</strong><p>Получена в 2023 году.</p></article></div><div class="education"><h3>Образование и профессиональное развитие</h3><div class="row"><div class="year">2005</div><div>Тверская государственная медицинская академия — специальность «Лечебное дело».</div></div><div class="row"><div class="year">2005–2006</div><div>Интернатура в МОНИКИ им. М. Ф. Владимирского.</div></div><div class="row"><div class="year">2007</div><div>Профессиональная переподготовка по кардиологии в Московском государственном медико-стоматологическом университете.</div></div><div class="row"><div class="year">2019</div><div>Профессиональная переподготовка по специальности «Функциональная диагностика».</div></div><div class="row"><div class="year">2020–2024</div><div>Повышение квалификации: кардиоэндокринология, аритмии, сахарный диабет и ожирение, коморбидные состояния, сомнология, артериальная гипертензия и другие направления.</div></div></div></section>
<section class="section" aria-labelledby="clinic-title"><div class="section-head"><p class="kicker">Где принимает</p><h2 id="clinic-title">Очный приём в «Мед Гарант»</h2></div><div class="clinic"><div><p class="label">Балашиха · мкр. Саввино</p><h3>Медицинский центр «Мед Гарант»</h3><p>Многопрофильный медицинский центр в Балашихе. Работает в Московской области с 2008 года и объединяет амбулаторную, диагностическую, стационарную и восстановительную помощь.</p><p class="address">ул. 1 Мая, д. 2, корп. 1</p></div><div class="clinic-action"><a class="button" href="https://lk.medgarant.info/reservation?initial=doc&step=datetime&department=10020850&dcode=10000436">Записаться к Ирине Трунькиной</a></div></div></section>
<section class="final" aria-labelledby="final-title"><p class="kicker">Очная консультация</p><h2 id="final-title">Начать можно с обычного приёма</h2><p>Если вас беспокоят сердечно-сосудистые симптомы, уже есть диагноз или результаты обследований, которые хочется спокойно разобрать, можно записаться на очную консультацию к Ирине Трунькиной.</p><div class="actions"><a class="button" href="https://lk.medgarant.info/reservation?initial=doc&step=datetime&department=10020850&dcode=10000436">Записаться на консультацию</a></div></section>
</div></main></body></html>