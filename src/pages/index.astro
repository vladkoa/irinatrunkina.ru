---
const title = 'Ирина Трунькина — врач-кардиолог и терапевт';
const description = 'Официальный сайт Ирины Трунькиной. Кардиология в контексте общего здоровья, очный приём и запись.';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      :root {
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #18212b;
        background: #f6f8fa;
      }
      * { box-sizing: border-box; }
      body { margin: 0; }
      main {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 32px 20px;
      }
      .card {
        width: min(820px, 100%);
        background: white;
        border: 1px solid #e4e8ec;
        border-radius: 24px;
        padding: clamp(28px, 6vw, 64px);
        box-shadow: 0 18px 60px rgba(20, 32, 45, 0.08);
      }
      .eyebrow {
        margin: 0 0 14px;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #566473;
      }
      h1 {
        margin: 0;
        font-size: clamp(38px, 8vw, 72px);
        line-height: 1.02;
        letter-spacing: -.04em;
      }
      .tagline {
        margin: 28px 0 0;
        font-size: clamp(28px, 5vw, 48px);
        line-height: 1.08;
        letter-spacing: -.03em;
      }
      .subhead {
        margin: 18px 0 0;
        font-size: clamp(19px, 3vw, 24px);
        font-weight: 700;
        line-height: 1.4;
        color: #314152;
      }
      .lead {
        margin: 20px 0 0;
        max-width: 700px;
        font-size: clamp(17px, 2.5vw, 20px);
        line-height: 1.65;
        color: #4b5968;
      }
      .detail {
        margin: 18px 0 0;
        font-size: 17px;
        line-height: 1.6;
        color: #314152;
      }
      .actions {
        margin-top: 30px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }
      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 22px;
        border-radius: 999px;
        background: #18212b;
        color: white;
        text-decoration: none;
        font-weight: 700;
        transition: transform .15s ease, opacity .15s ease;
      }
      .button:hover { transform: translateY(-1px); }
      .button:focus-visible { outline: 3px solid #a7b6c5; outline-offset: 3px; }
      .note {
        margin: 30px 0 0;
        padding-top: 22px;
        border-top: 1px solid #e7ebef;
        color: #6a7683;
        font-size: 14px;
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <main>
      <section class="card">
        <p class="eyebrow">Врач-кардиолог · терапевт</p>
        <h1>Ирина Трунькина</h1>

        <h2 class="tagline">Не только сердце</h2>
        <p class="subhead">Кардиология в контексте всего организма.</p>

        <p class="lead">
          Сердечно-сосудистые симптомы и риски рассматриваются с учётом обмена веществ,
          веса, сопутствующих состояний, образа жизни и данных обследований.
        </p>

        <p class="detail">
          <strong>При необходимости — расширенный разбор анализов и генетических данных.</strong>
        </p>

        <div class="actions">
          <a
            class="button"
            href="https://lk.medgarant.info/reservation?initial=doc&step=datetime&department=10020850&dcode=10000436"
          >
            Записаться на очный приём
          </a>
        </div>

        <p class="note">Главная страница находится в разработке. Следующие разделы будут добавляться постепенно.</p>
      </section>
    </main>
  </body>
</html>
