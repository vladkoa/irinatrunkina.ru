---
const title = 'Ирина Трунькина — врач-кардиолог и терапевт';
const description = 'Официальный сайт Ирины Трунькиной. Кардиология в контексте общего здоровья, очный приём и запись.';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      :root {
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #18212b;
        background: #f6f8fa;
      }
      * { box-sizing: border-box; }
      body { margin: 0; }
      main {
        padding: 32px 20px 72px;
      }
      .wrap {
        width: min(1080px, 100%);
        margin: 0 auto;
      }
      .card {
        background: white;
        border: 1px solid #e4e8ec;
        border-radius: 24px;
        padding: clamp(28px, 6vw, 64px);
        box-shadow: 0 18px 60px rgba(20, 32, 45, 0.08);
      }
      .eyebrow {
        margin: 0 0 14px;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #566473;
      }
      h1 {
        margin: 0;
        font-size: clamp(38px, 8vw, 72px);
        line-height: 1.02;
        letter-spacing: -.04em;
      }
      .tagline {
        margin: 28px 0 0;
        font-size: clamp(28px, 5vw, 48px);
        line-height: 1.08;
        letter-spacing: -.03em;
      }
      .subhead {
        margin: 18px 0 0;
        font-size: clamp(19px, 3vw, 24px);
        font-weight: 700;
        line-height: 1.4;
        color: #314152;
      }
      .lead {
        margin: 20px 0 0;
        max-width: 760px;
        font-size: clamp(17px, 2.5vw, 20px);
        line-height: 1.65;
        color: #4b5968;
      }
      .detail {
        margin: 18px 0 0;
        font-size: 17px;
        line-height: 1.6;
        color: #314152;
      }
      .actions {
        margin-top: 30px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }
      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 22px;
        border-radius: 999px;
        background: #18212b;
        color: white;
        text-decoration: none;
        font-weight: 700;
        transition: transform .15s ease, opacity .15s ease;
      }
      .button:hover { transform: translateY(-1px); }
      .button:focus-visible { outline: 3px solid #a7b6c5; outline-offset: 3px; }
      .section {
        padding: clamp(52px, 8vw, 88px) 0 0;
      }
      .section-kicker {
        margin: 0 0 10px;
        color: #6a7683;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      .section h2 {
        margin: 0;
        max-width: 820px;
        font-size: clamp(30px, 5vw, 48px);
        line-height: 1.08;
        letter-spacing: -.03em;
      }
      .section-intro {
        margin: 18px 0 0;
        max-width: 780px;
        color: #566473;
        font-size: 18px;
        line-height: 1.65;
      }
      .situations {
        margin-top: 32px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }
      .situation {
        background: white;
        border: 1px solid #e4e8ec;
        border-radius: 20px;
        padding: 26px;
      }
      .situation h3 {
        margin: 0;
        font-size: 21px;
        line-height: 1.3;
        letter-spacing: -.01em;
      }
      .situation p {
        margin: 10px 0 0;
        color: #596776;
        font-size: 16px;
        line-height: 1.6;
      }
      .section-note {
        margin: 24px 0 0;
        max-width: 760px;
        color: #6a7683;
        font-size: 14px;
        line-height: 1.6;
      }
      .approach-panel {
        margin-top: 32px;
        background: #18212b;
        color: white;
        border-radius: 24px;
        padding: clamp(26px, 5vw, 48px);
      }
      .approach-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 30px 36px;
      }
      .approach-step {
        display: grid;
        grid-template-columns: 42px 1fr;
        gap: 14px;
        align-items: start;
      }
      .step-number {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: rgba(255,255,255,.1);
        font-weight: 800;
        font-size: 14px;
      }
      .approach-step h3 {
        margin: 1px 0 0;
        font-size: 20px;
        line-height: 1.3;
      }
      .approach-step p {
        margin: 8px 0 0;
        color: #cbd3dc;
        font-size: 15px;
        line-height: 1.6;
      }
      .approach-summary {
        margin: 34px 0 0;
        padding-top: 26px;
        border-top: 1px solid rgba(255,255,255,.16);
        max-width: 820px;
        font-size: clamp(18px, 2.5vw, 22px);
        line-height: 1.55;
      }
      @media (max-width: 720px) {
        main { padding: 16px 16px 56px; }
        .situations,
        .approach-grid { grid-template-columns: 1fr; }
        .situation { padding: 22px; }
        .approach-step { grid-template-columns: 38px 1fr; }
        .step-number { width: 38px; height: 38px; }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="wrap">
        <section class="card">
          <p class="eyebrow">Врач-кардиолог · терапевт</p>
          <h1>Ирина Трунькина</h1>

          <h2 class="tagline">Не только сердце</h2>
          <p class="subhead">Кардиология в контексте всего организма.</p>

          <p class="lead">
            Сердечно-сосудистые симптомы и риски рассматриваются с учётом обмена веществ,
            веса, сопутствующих состояний, образа жизни и данных обследований.
          </p>

          <p class="detail">
            <strong>При необходимости — расширенный разбор анализов и генетических данных.</strong>
          </p>

          <div class="actions">
            <a
              class="button"
              href="https://lk.medgarant.info/reservation?initial=doc&step=datetime&department=10020850&dcode=10000436"
            >
              Записаться на очный приём
            </a>
          </div>
        </section>

        <section class="section" aria-labelledby="situations-title">
          <p class="section-kicker">С чем можно обратиться</p>
          <h2 id="situations-title">Когда важно разобраться не только с одним симптомом</h2>
          <p class="section-intro">
            Поводом для консультации может быть не только уже установленный диагноз. Иногда задача —
            понять, что стоит за жалобами, оценить риски и собрать разрозненные данные в понятный план.
          </p>

          <div class="situations">
            <article class="situation">
              <h3>Давление остаётся высоким</h3>
              <p>Если показатели часто повышаются, лечение приходится менять или самочувствие остаётся нестабильным.</p>
            </article>

            <article class="situation">
              <h3>Одышка, сердцебиение, слабость</h3>
              <p>Когда симптомы есть, а обследования не дают простого и понятного объяснения.</p>
            </article>

            <article class="situation">
              <h3>Боль или дискомфорт в груди</h3>
              <p>Чтобы оценить сердечно-сосудистый риск и понять, какое обследование действительно нужно дальше.</p>
            </article>

            <article class="situation">
              <h3>Высокий холестерин или атеросклероз</h3>
              <p>Если нужно оценить общий риск, разобраться в показателях и понять дальнейшую тактику.</p>
            </article>

            <article class="situation">
              <h3>Вес, сахар, давление и холестерин связаны между собой</h3>
              <p>Когда сердечно-сосудистый риск нельзя рассматривать отдельно от обмена веществ и сопутствующих состояний.</p>
            </article>

            <article class="situation">
              <h3>Диагноз уже есть, но остаются вопросы</h3>
              <p>Если хочется спокойно пересмотреть результаты обследований, лечение и дальнейшие шаги.</p>
            </article>
          </div>

          <p class="section-note">
            Перечень не заменяет медицинскую оценку и не является списком диагнозов для самодиагностики.
          </p>
        </section>

        <section class="section" aria-labelledby="approach-title">
          <p class="section-kicker">Как строится разбор</p>
          <h2 id="approach-title">Симптом — это начало разбора, а не всегда готовый диагноз</h2>
          <p class="section-intro">
            Сердечно-сосудистые жалобы оцениваются в общей клинической картине: важно понять не только,
            что беспокоит сейчас, но и какие факторы могут поддерживать симптомы и влиять на риск.
          </p>

          <div class="approach-panel">
            <div class="approach-grid">
              <article class="approach-step">
                <div class="step-number">01</div>
                <div>
                  <h3>Что происходит сейчас</h3>
                  <p>Жалобы, их динамика, уже поставленные диагнозы, результаты обследований и текущее лечение.</p>
                </div>
              </article>

              <article class="approach-step">
                <div class="step-number">02</div>
                <div>
                  <h3>Что влияет на сердечно-сосудистый риск</h3>
                  <p>Давление, липидный и углеводный обмен, вес, сопутствующие заболевания и другие значимые факторы.</p>
                </div>
              </article>

              <article class="approach-step">
                <div class="step-number">03</div>
                <div>
                  <h3>Что может быть связано с симптомами</h3>
                  <p>При необходимости учитываются сопутствующие состояния, образ жизни, принимаемые препараты, лабораторные данные и результаты других исследований.</p>
                </div>
              </article>

              <article class="approach-step">
                <div class="step-number">04</div>
                <div>
                  <h3>Какой следующий шаг действительно нужен</h3>
                  <p>Что уже понятно, что стоит уточнить, как выстроить дальнейшее обследование, лечение или маршрутизацию.</p>
                </div>
              </article>
            </div>

            <p class="approach-summary">
              Если причина симптомов выходит за рамки кардиологии, задача — не остановиться на формулировке
              «с сердцем всё нормально», а понять, <strong>куда смотреть дальше и как собрать последовательный план действий.</strong>
            </p>
          </div>
        </section>
      </div>
    </main>
  </body>
</html>
