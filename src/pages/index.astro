---
const title = 'Ирина Анатольевна Трунькина — кардиолог, терапевт в Балашихе';
const description = 'Ирина Анатольевна Трунькина — врач-кардиолог и терапевт. Очный приём в медицинском центре «Мед Гарант», Балашиха, мкр. Саввино. Запись на приём.';
const canonical = 'https://irinatrunkina.ru/';
const appointmentUrl = 'https://lk.medgarant.info/reservation?initial=doc&step=datetime&department=10020850&dcode=10000436';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ирина Анатольевна Трунькина',
  alternateName: 'Ирина Трунькина',
  url: canonical,
  jobTitle: 'Врач-кардиолог, терапевт',
  worksFor: {
    '@type': 'MedicalClinic',
    name: 'Медицинский центр «Мед Гарант»',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'мкр. Саввино, ул. 1 Мая, д. 2, корп. 1',
      addressLocality: 'Балашиха',
      addressRegion: 'Московская область',
      postalCode: '143985',
      addressCountry: 'RU',
    },
  },
};
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ирина Трунькина" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

    <style>
      :root {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
        color: #202725;
        background: #f6f4ef;
        font-synthesis: none;
      }

      * { box-sizing: border-box; }
      html { min-width: 320px; }
      body { margin: 0; background: #f6f4ef; }

      main {
        min-height: 100svh;
        display: flex;
        align-items: center;
        padding: 72px 24px;
      }

      .page {
        width: min(760px, 100%);
        margin: 0 auto;
      }

      .eyebrow {
        margin: 0 0 20px;
        color: #66716d;
        font-size: 13px;
        font-weight: 650;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        max-width: 720px;
        font-size: clamp(42px, 8vw, 72px);
        line-height: 0.98;
        letter-spacing: -0.045em;
        font-weight: 680;
      }

      .role {
        margin: 24px 0 0;
        color: #36423e;
        font-size: clamp(21px, 3vw, 27px);
        line-height: 1.35;
      }

      .clinic {
        margin-top: 48px;
        padding-top: 28px;
        border-top: 1px solid #d8d9d4;
      }

      .location {
        margin: 0 0 8px;
        color: #66716d;
        font-size: 15px;
      }

      .clinic-name {
        margin: 0;
        font-size: 22px;
        line-height: 1.35;
        font-weight: 650;
      }

      .address {
        margin: 8px 0 0;
        color: #66716d;
        font-size: 16px;
        line-height: 1.55;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 50px;
        margin-top: 28px;
        padding: 0 24px;
        border-radius: 10px;
        background: #2f6fa3;
        color: #fff;
        text-decoration: none;
        font-size: 16px;
        font-weight: 650;
        transition: background-color 150ms ease;
      }

      .button:hover { background: #245b88; }
      .button:focus-visible { outline: 3px solid #a8c8e2; outline-offset: 3px; }

      .experience {
        margin: 30px 0 0;
        color: #7a817e;
        font-size: 14px;
        line-height: 1.5;
      }

      @media (max-width: 560px) {
        main { align-items: flex-start; padding: 56px 20px 48px; }
        .eyebrow { margin-bottom: 18px; font-size: 12px; }
        h1 { font-size: clamp(40px, 14vw, 56px); }
        .role { margin-top: 20px; font-size: 21px; }
        .clinic { margin-top: 40px; padding-top: 24px; }
        .button { width: 100%; }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="page">
        <h1>Ирина Трунькина</h1>
        <p class="role">Врач-кардиолог · терапевт</p>

        <section class="clinic" aria-label="Место приёма">
          <p class="location">Очный приём</p>
          <p class="clinic-name">Медицинский центр «Мед Гарант»</p>
          <p class="address">Московская область, г. Балашиха, мкр. Саввино,<br />ул. 1 Мая, д. 2, корп. 1</p>
          <a class="button" href={appointmentUrl}>Записаться на приём</a>
        </section>

        <p class="experience">Стаж работы — с 2006 года.</p>
      </div>
    </main>
  </body>
</html>



