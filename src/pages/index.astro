<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      :root {
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
        --bg: #f7f7f4;
        --card: #ffffff;
        --ink: #263338;
        --muted: #687579;
        --line: #e3e7e5;
        --accent: #4f6f76;
        --accent-soft: #eef3f3;
        color: var(--ink);
        background: var(--bg);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--bg); }
      main { padding: 24px 18px 64px; }
      .wrap { width: min(1060px, 100%); margin: 0 auto; }

      .hero-card {
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(300px, .92fr);
        gap: clamp(34px, 5vw, 60px);
        align-items: center;
        padding: clamp(30px, 5vw, 54px);
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 24px;
      }
      .hero-copy { min-width: 0; }
      .hero-photo { margin: 0; width: 100%; max-width: 390px; justify-self: end; }
      .hero-photo-frame {
        overflow: hidden;
        aspect-ratio: 4 / 5;
        border-radius: 20px;
        background: #f0f2f1;
        border: 1px solid var(--line);
      }
      .hero-photo img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: center 22%; }

      .eyebrow,
      .section-kicker,
      .data-label,
      .fact-label,
      .clinic-label {
        margin: 0;
        color: var(--accent);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .055em;
      }
      .eyebrow {
        display: inline-flex;
        margin-bottom: 18px;
        padding: 7px 11px;
        border-radius: 999px;
        background: var(--accent-soft);
      }

      h1 {
        margin: 0;
        max-width: 620px;
        font-size: clamp(42px, 5.6vw, 62px);
        font-weight: 650;
        line-height: 1.02;
        letter-spacing: -.035em;
      }
      .tagline {
        margin: 24px 0 0;
        color: var(--accent);
        font-size: clamp(29px, 4vw, 41px);
        font-weight: 620;
        line-height: 1.08;
        letter-spacing: -.025em;
      }
      .subhead {
        margin: 12px 0 0;
        max-width: 620px;
        color: #394a4f;
        font-size: clamp(18px, 2.1vw, 21px);
        font-weight: 600;
        line-height: 1.42;
      }
      .lead,
      .section-intro {
        color: var(--muted);
        line-height: 1.65;
      }
      .lead { margin: 18px 0 0; max-width: 650px; font-size: 17px; }
      .detail {
        margin: 20px 0 0;
        max-width: 620px;
        padding: 13px 15px;
        background: var(--accent-soft);
        border-radius: 12px;
        color: #465a5f;
        font-size: 15px;
        line-height: 1.55;
      }

      .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 20px;
        border-radius: 999px;
        background: var(--accent);
        color: white;
        font-weight: 700;
        text-decoration: none;
        transition: transform .15s ease, opacity .15s ease;
      }
      .button:hover { transform: translateY(-1px); opacity: .92; }
      .button:focus-visible { outline: 3px solid #b9cbce; outline-offset: 3px; }

      .section { padding-top: clamp(50px, 7vw, 76px); }
      .section-head { max-width: 790px; }
      .section-kicker { margin-bottom: 9px; }
      .section h2,
      .final-cta h2 {
        margin: 0;
        max-width: 790px;
        font-size: clamp(30px, 3.8vw, 39px);
        font-weight: 620;
        line-height: 1.13;
        letter-spacing: -.02em;
      }
      .section-intro { margin: 15px 0 0; max-width: 760px; font-size: 16px; }

      .situations,
      .data-panel,
      .facts-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        margin-top: 25px;
      }
      .situation,
      .data-card,
      .fact-card,
      .education-card,
      .clinic-card,
      .approach-panel,
      .final-cta {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 17px;
      }
      .situation,
      .data-card { padding: 22px; }
      .situation h3,
      .data-card h3 {
        margin: 0;
        color: #2c3b40;
        font-size: 19px;
        font-weight: 620;
        line-height: 1.32;
      }
      .situation p,
      .data-card p {
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 14.5px;
        line-height: 1.58;
      }
      .section-note {
        margin: 18px 0 0;
        max-width: 760px;
        color: #7b8588;
        font-size: 12.5px;
        line-height: 1.55;
      }

      .approach-panel {
        margin-top: 25px;
        padding: clamp(22px, 4vw, 36px);
        background: #fbfcfb;
      }
      .approach-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px 30px;
      }
      .approach-step { display: grid; grid-template-columns: 36px 1fr; gap: 12px; align-items: start; }
      .step-number {
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--accent-soft);
        color: var(--accent);
        font-size: 12px;
        font-weight: 800;
      }
      .approach-step h3 { margin: 1px 0 0; font-size: 17px; font-weight: 620; line-height: 1.32; }
      .approach-step p { margin: 7px 0 0; color: var(--muted); font-size: 14px; line-height: 1.58; }
      .approach-summary {
        margin: 25px 0 0;
        padding-top: 20px;
        border-top: 1px solid var(--line);
        max-width: 820px;
        color: #485b60;
        font-size: 17px;
        line-height: 1.55;
      }

      .data-label,
      .fact-label,
      .clinic-label { margin-bottom: 9px; }
      .data-summary {
        margin: 14px 0 0;
        max-width: 900px;
        padding: 18px 20px;
        border-radius: 14px;
        background: var(--accent-soft);
        color: #475b60;
        font-size: 14.5px;
        line-height: 1.58;
      }

      .facts-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .fact-card { padding: 20px; }
      .fact-card strong { display: block; color: #2c3b40; font-size: 19px; font-weight: 620; line-height: 1.3; }
      .fact-card p { margin: 7px 0 0; color: var(--muted); font-size: 14px; line-height: 1.5; }

      .education-card { margin-top: 14px; padding: clamp(21px, 3.4vw, 30px); }
      .education-card h3 { margin: 0 0 16px; font-size: 21px; font-weight: 620; }
      .timeline { display: grid; }
      .timeline-row {
        display: grid;
        grid-template-columns: 112px 1fr;
        gap: 18px;
        padding: 15px 0;
        border-top: 1px solid #e7eae8;
      }
      .timeline-row:first-child { padding-top: 0; border-top: 0; }
      .timeline-year { color: var(--accent); font-weight: 700; }
      .timeline-text { color: var(--muted); line-height: 1.55; }

      .clinic-card {
        display: grid;
        grid-template-columns: 1.2fr .8fr;
        gap: 28px;
        align-items: center;
        margin-top: 24px;
        padding: clamp(22px, 3.8vw, 32px);
      }
      .clinic-card h3 { margin: 0; color: #2c3b40; font-size: clamp(24px, 3.1vw, 30px); font-weight: 620; line-height: 1.18; }
      .clinic-card p { margin: 11px 0 0; color: var(--muted); font-size: 14.5px; line-height: 1.58; }
      .clinic-address { color: #47595e !important; font-weight: 650; }
      .clinic-action { display: flex; justify-content: flex-end; }

      .final-cta {
        margin-top: clamp(50px, 7vw, 76px);
        padding: clamp(28px, 4.6vw, 44px);
        background: #f1f4f3;
      }
      .final-cta p { margin: 15px 0 0; max-width: 740px; color: var(--muted); font-size: 16px; line-height: 1.62; }

      @media (max-width: 820px) {
        .hero-card { grid-template-columns: 1fr; }
        .hero-photo { order: -1; max-width: 520px; justify-self: stretch; margin: 0 auto; }
        .hero-photo-frame { aspect-ratio: 5 / 4; }
        .hero-photo img { object-position: center 20%; }
      }

      @media (max-width: 720px) {
        main { padding: 10px 10px 44px; }
        .hero-card { padding: 16px; gap: 20px; border-radius: 18px; }
        .hero-photo-frame { aspect-ratio: 1 / 1; border-radius: 14px; }
        .hero-photo img { object-position: center 18%; }
        .eyebrow { margin-bottom: 15px; }
        h1 { font-size: 40px; line-height: .98; }
        .tagline { margin-top: 20px; font-size: 29px; }
       .subhead { font-size: 18px; }
        .lead { font-size: 16px; }
        .section { padding-top: 44px; }
        .section h2,
        .final-cta h2 { font-size: 28px; line-height: 1.16; }
       .section-intro { font-size: 15.5px; }
       .situations,
        .approach-grid,
        .data-panel,
        .facts-grid,
        .clinic-card { grid-template-columns: 1fr; }
        .situations,
        .data-panel,
        .facts-grid { gap: 10px; margin-top: 20px; }
       .situation,
        .data-card,
        .fact-card { padding: 18px; }
        .approach-panel { margin-top: 20px; padding: 18px; }
       .approach-grid { gap: 20px; }
        .approach-step { grid-template-columns: 34px 1fr; }
        .step-number { width: 34px; height: 34px; }
        .timeline-row { grid-template-columns: 1fr; gap: 5px; }
        .clinic-card { gap: 20px; }
        .clinic-action { justify-content: flex-start; }
        .final-cta { border-radius: 16px; }
      }
    </style>
  </head>
