---
const title = 'Ирина Трунькина — врач-кардиолог и терапевт';
const description = 'Официальный сайт Ирины Трунькиной. Кардиология в контексте общего здоровья, очный приём и запись.';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      :root {
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #18212b;
        background: #f3f7f7;
        --ink: #18212b;
        --muted: #596776;
        --accent: #217f86;
        --accent-dark: #16676d;
        --accent-soft: #e8f5f4;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: #f3f7f7; }
      main { padding: 32px 20px 72px; }
      .wrap { width: min(1080px, 100%); margin: 0 auto; }
      .card {
        background: linear-gradient(135deg, #ffffff 0%, #f4fbfa 100%);
        border: 1px solid #dfe9e9;
        border-radius: 28px;
        padding: clamp(28px, 5vw, 56px);
        box-shadow: 0 18px 60px rgba(20, 50, 55, 0.08);
      }
      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.12fr) minmax(300px, .88fr);
        gap: clamp(30px, 5vw, 64px);
        align-items: center;
        overflow: hidden;
      }
      .hero-copy { min-width: 0; }
      .hero-photo {
        margin: 0;
        width: 100%;
        max-width: 390px;
        justify-self: end;
      }
      .hero-photo-frame {
        position: relative;
        overflow: hidden;
        aspect-ratio: 4 / 5;
        border-radius: 28px;
        background: #dff1f0;
        box-shadow: 0 20px 50px rgba(24, 74, 80, 0.14);
      }
      .hero-photo-frame::after {
        content: "";
        position: absolute;
        inset: 0;
        border: 1px solid rgba(33, 127, 134, .16);
        border-radius: inherit;
        pointer-events: none;
      }
      .hero-photo img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center center;
      }
      .eyebrow,
      .section-kicker,
      .data-label,
      .fact-label,
      .clinic-label {
        color: #6a7683;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      .eyebrow {
        margin: 0 0 18px;
        display: inline-flex;
        align-items: center;
        padding: 8px 12px;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent-dark);
        font-size: 13px;
        letter-spacing: .06em;
      }
      h1 {
        margin: 0;
        font-size: clamp(42px, 6vw, 68px);
        line-height: 1.02;
        letter-spacing: -.04em;
        color: var(--ink);
      }
      .tagline {
        margin: 28px 0 0;
        font-size: clamp(30px, 4.4vw, 46px);
        line-height: 1.06;
        letter-spacing: -.035em;
        color: var(--accent-dark);
      }
      .subhead {
        margin: 16px 0 0;
        font-size: clamp(19px, 2.5vw, 23px);
        font-weight: 700;
        line-height: 1.4;
        color: #314152;
      }
      .lead,
      .section-intro {
        max-width: 780px;
        color: #566473;
        line-height: 1.65;
      }
      .lead { margin: 20px 0 0; font-size: clamp(17px, 2.2vw, 19px); }
      .detail {
        margin: 20px 0 0;
        padding: 14px 16px;
        max-width: 620px;
        border-left: 3px solid var(--accent);
        border-radius: 0 14px 14px 0;
        background: rgba(33, 127, 134, .07);
        font-size: 16px;
        line-height: 1.55;
        color: #314152;
      }
      .actions { margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap; }
      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 22px;
        border-radius: 999px;
        background: var(--accent-dark);
        color: white;
        text-decoration: none;
        font-weight: 700;
        transition: transform .15s ease, background .15s ease;
      }
      .button:hover { transform: translateY(-1px); background: #105b60; }
      .button:focus-visible { outline: 3px solid #9fcfd0; outline-offset: 3px; }
      .section { padding: clamp(52px, 8vw, 88px) 0 0; }
      .section-kicker { margin: 0 0 10px; font-size: 14px; }
      .section h2 {
        margin: 0;
        max-width: 820px;
        font-size: clamp(30px, 5vw, 48px);
        line-height: 1.08;
        letter-spacing: -.03em;
      }
      .section-intro { margin: 18px 0 0; font-size: 18px; }
      .situations,
      .data-panel,
      .facts-grid {
        margin-top: 32px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }
      .situation,
      .data-card,
      .fact-card,
      .education-card,
      .clinic-card {
        background: white;
        border: 1px solid #e4e8ec;
        border-radius: 20px;
      }
      .situation,
      .data-card { padding: 26px; }
      .situation h3,
      .data-card h3,
      .fact-card strong { margin: 0; line-height: 1.3; }
      .situation h3 { font-size: 21px; }
      .situation p,
      .data-card p { margin: 10px 0 0; color: #596776; font-size: 16px; line-height: 1.6; }
      .section-note { margin: 24px 0 0; max-width: 760px; color: #6a7683; font-size: 14px; line-height: 1.6; }
      .approach-panel {
        margin-top: 32px;
        background: #18212b;
        color: white;
        border-radius: 24px;
        padding: clamp(26px, 5vw, 48px);
      }
      .approach-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 30px 36px;
      }
      .approach-step { display: grid; grid-template-columns: 42px 1fr; gap: 14px; align-items: start; }
      .step-number {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: rgba(255,255,255,.1);
        font-weight: 800;
        font-size: 14px;
      }
      .approach-step h3 { margin: 1px 0 0; font-size: 20px; line-height: 1.3; }
      .approach-step p { margin: 8px 0 0; color: #cbd3dc; font-size: 15px; line-height: 1.6; }
      .approach-summary {
        margin: 34px 0 0;
        padding-top: 26px;
        border-top: 1px solid rgba(255,255,255,.16);
        max-width: 820px;
        font-size: clamp(18px, 2.5vw, 22px);
        line-height: 1.55;
      }
      .data-label,
      .fact-label,
      .clinic-label { margin: 0 0 12px; }
      .data-card h3 { font-size: 23px; line-height: 1.25; }
      .data-summary {
        margin: 16px 0 0;
        padding: 24px 26px;
        border-radius: 20px;
        background: #eef2f5;
        max-width: 900px;
        color: #314152;
        font-size: 17px;
        line-height: 1.65;
      }
      .facts-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .fact-card { padding: 24px; }
      .fact-card strong { display: block; font-size: 22px; }
      .fact-card p { margin: 8px 0 0; color: #596776; font-size: 15px; line-height: 1.55; }
      .education-card { margin-top: 16px; padding: clamp(24px, 4vw, 36px); }
      .education-card h3 { margin: 0 0 22px; font-size: 24px; }
      .timeline { display: grid; gap: 0; }
      .timeline-row {
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: 22px;
        padding: 18px 0;
        border-top: 1px solid #e7ebef;
      }
      .timeline-row:first-child { border-top: 0; padding-top: 0; }
      .timeline-year { font-weight: 800; color: #314152; }
      .timeline-text { color: #596776; line-height: 1.6; }
      .clinic-card {
        margin-top: 32px;
        padding: clamp(26px, 5vw, 42px);
        display: grid;
        grid-template-columns: 1.25fr .75fr;
        gap: 36px;
        align-items: center;
      }
      .clinic-card h3 {
        margin: 0;
        font-size: clamp(26px, 4vw, 36px);
        line-height: 1.15;
        letter-spacing: -.02em;
      }
      .clinic-card p {
        margin: 14px 0 0;
        color: #596776;
        font-size: 16px;
        line-height: 1.65;
      }
      .clinic-meta {
        margin-top: 20px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .clinic-meta span {
        display: inline-flex;
        padding: 8px 12px;
        border-radius: 999px;
        background: #eef2f5;
        color: #44515f;
        font-size: 14px;
        font-weight: 700;
      }
      .clinic-action {
        display: flex;
        justify-content: flex-end;
      }
      .final-cta {
        margin-top: clamp(56px, 9vw, 96px);
        padding: clamp(34px, 6vw, 64px);
        border-radius: 24px;
        background: #18212b;
        color: white;
      }
      .final-cta .section-kicker { color: #aeb8c3; }
      .final-cta h2 {
        margin: 0;
        max-width: 760px;
        font-size: clamp(32px, 5vw, 52px);
        line-height: 1.08;
        letter-spacing: -.03em;
      }
      .final-cta p {
        margin: 18px 0 0;
        max-width: 760px;
        color: #cbd3dc;
        font-size: 18px;
        line-height: 1.65;
      }
      .final-cta .button {
        background: white;
        color: #18212b;
      }
      .final-cta .button:hover { background: #eff8f7; }
      @media (max-width: 820px) {
        .hero { grid-template-columns: 1fr; }
        .hero-photo {
          max-width: 500px;
          justify-self: stretch;
          margin: 4px auto 0;
        }
        .hero-photo-frame { aspect-ratio: 5 / 4; }
        .hero-photo img { object-position: center 30%; }
      }
      @media (max-width: 720px) {
        main { padding: 16px 16px 56px; }
        .card { padding: 24px; border-radius: 22px; }
        .hero { gap: 28px; }
        .hero-photo-frame { aspect-ratio: 1 / 1; border-radius: 20px; }
        .situations,
        .approach-grid,
        .data-panel,
        .facts-grid,
        .clinic-card { grid-template-columns: 1fr; }
        .approach-step { grid-template-columns: 38px 1fr; }
        .step-number { width: 38px; height: 38px; }
        .timeline-row { grid-template-columns: 1fr; gap: 6px; }
        .clinic-action { justify-content: flex-start; }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="wrap">
        <section class="card hero">
          <div class="hero-copy">
            <p class="eyebrow">Врач-кардиолог · терапевт</p>
            <h1>Ирина Трунькина</h1>
            <h2 class="tagline">Не только сердце</h2>
            <p class="subhead">Кардиология в контексте всего организма.</p>
            <p class="lead">
              Сердечно-сосудистые симптомы и риски рассматриваются с учётом обмена веществ,
              веса, сопутствующих состояний, образа жизни и данных обследований.
            </p>
            <p class="detail"><strong>При необходимости — расширенный разбор анализов и генетических данных.</strong></p>
            <div class="actions">
              <a class="button" href="https://lk.medgarant.info/reservation?initial=doc&step=datetime&department=10020850&dcode=10000436">
                Записаться на очный приём
              </a>
            </div>
          </div>

          <figure class="hero-photo" aria-label="Фотография Ирины Трунькиной">
            <div class="hero-photo-frame">
              <img
                src="/ira-trunkina.jpg"
                alt="Ирина Трунькина, врач-кардиолог и терапевт"
                width="1248"
                height="1248"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          </figure>
        </section>

        <section class="section" aria-labelledby="situations-title">
          <p class="section-kicker">С чем можно обратиться</p>
          <h2 id="situations-title">Когда важно разобраться не только с одним симптомом</h2>
          <p class="section-intro">
            Поводом для консультации может быть не только уже установленный диагноз. Иногда задача —
            понять, что стоит за жалобами, оценить риски и собрать разрозненные данные в понятный план.
          </p>
          <div class="situations">
            <article class="situation"><h3>Давление остаётся высоким</h3><p>Если показатели часто повышаются, лечение приходится менять или самочувствие остаётся нестабильным.</p></article>
            <article class="situation"><h3>Одышка, сердцебиение, слабость</h3><p>Когда симптомы есть, а обследования не дают простого и понятного объяснения.</p></article>
            <article class="situation"><h3>Боль или дискомфорт в груди</h3><p>Чтобы оценить сердечно-сосудистый риск и понять, какое обследование действительно нужно дальше.</p></article>
            <article class="situation"><h3>Высокий холестерин или атеросклероз</h3><p>Если нужно оценить общий риск, разобраться в показателях и понять дальнейшую тактику.</p></article>
            <article class="situation"><h3>Вес, сахар, давление и холестерин связаны между собой</h3><p>Когда сердечно-сосудистый риск нельзя рассматривать отдельно от обмена веществ и сопутствующих состояний.</p></article>
            <article class="situation"><h3>Диагноз уже есть, но остаются вопросы</h3><p>Если хочется спокойно пересмотреть результаты обследований, лечение и дальнейшие шаги.</p></article>
          </div>
          <p class="section-note">Перечень не заменяет медицинскую оценку и не является списком диагнозов для самодиагностики.</p>
        </section>

        <section class="section" aria-labelledby="approach-title">
          <p class="section-kicker">Как строится разбор</p>
          <h2 id="approach-title">Симптом — это начало разбора, а не всегда готовый диагноз</h2>
          <p class="section-intro">
            Сердечно-сосудистые жалобы оцениваются в общей клинической картине: важно понять не только,
            что беспокоит сейчас, но и какие факторы могут поддерживать симптомы и влиять на риск.
          </p>
          <div class="approach-panel">
            <div class="approach-grid">
              <article class="approach-step"><div class="step-number">01</div><div><h3>Что происходит сейчас</h3><p>Жалобы, их динамика, уже поставленные диагнозы, результаты обследований и текущее лечение.</p></div></article>
              <article class="approach-step"><div class="step-number">02</div><div><h3>Что влияет на сердечно-сосудистый риск</h3><p>Давление, липидный и углеводный обмен, вес, сопутствующие заболевания и другие значимые факторы.</p></div></article>
              <article class="approach-step"><div class="step-number">03</div><div><h3>Что может быть связано с симптомами</h3><p>При необходимости учитываются сопутствующие состояния, образ жизни, принимаемые препараты, лабораторные данные и результаты других исследований.</p></div></article>
              <article class="approach-step"><div class="step-number">04</div><div><h3>Какой следующий шаг действительно нужен</h3><p>Что уже понятно, что стоит уточнить, как выстроить дальнейшее обследование, лечение или маршрутизацию.</p></div></article>
            </div>
            <p class="approach-summary">
              Если причина симптомов выходит за рамки кардиологии, задача — не остановиться на формулировке
              «с сердцем всё нормально», а понять, <strong>куда смотреть дальше и как собрать последовательный план действий.</strong>
            </p>
          </div>
        </section>

        <section class="section" aria-labelledby="data-title">
          <p class="section-kicker">Дополнительные данные</p>
          <h2 id="data-title">Когда в общей картине важны анализы и генетика</h2>
          <p class="section-intro">
            Не каждому пациенту нужен генетический тест или расширенный набор исследований. Но если такие данные
            уже есть или для них есть клиническая задача, их можно рассматривать вместе с анамнезом, симптомами и обычной диагностикой.
          </p>
          <div class="data-panel">
            <article class="data-card">
              <p class="data-label">Лабораторные данные</p>
              <h3>Не отдельные цифры, а их место в общей картине</h3>
              <p>Результаты анализов сопоставляются с жалобами, диагнозами, лечением и факторами риска, чтобы понять, какие показатели действительно требуют внимания и что стоит уточнить дальше.</p>
            </article>
            <article class="data-card">
              <p class="data-label">Генетические исследования</p>
              <h3>Дополнительный источник информации, а не диагноз сам по себе</h3>
              <p>Если генетическое исследование уже выполнено, его результаты рассматриваются как часть более широкой клинической картины. Генетические данные не заменяют обследование и не определяют лечение изолированно.</p>
            </article>
          </div>
          <p class="data-summary"><strong>Смысл не в «лечении по генам».</strong> Дополнительные данные используются только там, где они могут помочь лучше сформулировать вопросы профилактики, обследования и дальнейшего наблюдения.</p>
        </section>

        <section class="section" aria-labelledby="about-title">
          <p class="section-kicker">О враче</p>
          <h2 id="about-title">Кардиолог, терапевт, врач функциональной диагностики</h2>
          <p class="section-intro">
            Ирина Трунькина работает со взрослыми пациентами с заболеваниями сердечно-сосудистой системы и терапевтической патологией. Стаж работы — с 2006 года.
          </p>

          <div class="facts-grid">
            <article class="fact-card">
              <p class="fact-label">Базовое образование</p>
              <strong>Лечебное дело</strong>
              <p>Тверская государственная медицинская академия, 2005 год.</p>
            </article>
            <article class="fact-card">
              <p class="fact-label">Специализация</p>
              <strong>Кардиология</strong>
              <p>Профессиональная переподготовка, 2007 год.</p>
            </article>
            <article class="fact-card">
              <p class="fact-label">Квалификация</p>
              <strong>Первая категория</strong>
              <p>Получена в 2023 году.</p>
            </article>
          </div>

          <div class="education-card">
            <h3>Образование и профессиональное развитие</h3>
            <div class="timeline">
              <div class="timeline-row">
                <div class="timeline-year">2005</div>
                <div class="timeline-text">Тверская государственная медицинская академия — специальность «Лечебное дело».</div>
              </div>
              <div class="timeline-row">
                <div class="timeline-year">2005–2006</div>
                <div class="timeline-text">Интернатура в МОНИКИ им. М. Ф. Владимирского.</div>
              </div>
              <div class="timeline-row">
                <div class="timeline-year">2007</div>
                <div class="timeline-text">Профессиональная переподготовка по кардиологии в Московском государственном медико-стоматологическом университете.</div>
              </div>
              <div class="timeline-row">
                <div class="timeline-year">2019</div>
                <div class="timeline-text">Профессиональная переподготовка по специальности «Функциональная диагностика».</div>
              </div>
              <div class="timeline-row">
                <div class="timeline-year">2020–2024</div>
                <div class="timeline-text">Регулярное повышение квалификации: кардиоэндокринология, аритмии, сахарный диабет и ожирение, коморбидные состояния, сомнология, артериальная гипертензия и другие направления.</div>
              </div>
            </div>
          </div>
        </section>

        <section class="section" aria-labelledby="clinic-title">
          <p class="section-kicker">Где принимает</p>
          <h2 id="clinic-title">Очный приём в медицинском центре «Мед Гарант»</h2>
          <p class="section-intro">
            Сейчас основной маршрут записи на сайте ведёт на очный приём Ирины Трунькиной в «Мед Гарант».
          </p>

          <div class="clinic-card">
            <div>
              <p class="clinic-label">Мед Гарант · Балашиха, мкр. Саввино</p>
              <h3>Многопрофильный медицинский центр</h3>
              <p>
                «Мед Гарант» работает в Московской области с 2008 года. Центр объединяет амбулаторную,
